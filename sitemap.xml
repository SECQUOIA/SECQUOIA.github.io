---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.html_pages %}
    {% unless page.url == "/404.html" or page.sitemap.exclude == "yes" or page.sitemap == false or page.redirect or page.redirect_to %}
  <url>
    <loc>{{ page.url | remove: "index.html" | absolute_url }}</loc>
    {% assign mod_date = page.last_modified_at | default: page.date %}
    {% if mod_date %}
    <lastmod>{{ mod_date | date: "%Y-%m-%d" }}</lastmod>
    {% endif %}
    <changefreq>monthly</changefreq>
    <priority>{% if page.url == "/" %}1.0{% else %}0.8{% endif %}</priority>
  </url>
    {% endunless %}
  {% endfor %}
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endfor %}
</urlset>
